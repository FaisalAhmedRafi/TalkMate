# TalkMate API — copy to .env (git-ignored) and fill in. Never commit real values.
# Production values live only in the host's environment settings (see docs/guides/deployment.md).

# --- required ---
DATABASE_URL=mysql://talkpal:talkpal@localhost:3306/talkpal
# Production: `openssl rand -hex 32` (64 chars). Any 32+ chars is fine locally.
JWT_SECRET=change-me-local-only-0123456789abcdef

# --- AI (needed for every practice mode) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_FALLBACK_MODELS=

# --- URLs ---
# Comma-separated CORS origins; the first is also the base of password-reset links.
FRONTEND_URL=http://localhost:3000
# Public base URL of this API, used to build /media/... picture URLs.
PUBLIC_API_URL=http://localhost:4000
PORT=4000

# --- admin panel: comma-separated account emails allowed into /admin ---
ADMIN_EMAILS=

# --- email (verification codes, password reset). Without a mailer the code is printed in the log. ---
GMAIL_USER=
GMAIL_APP_PASSWORD=
RESEND_API_KEY=
MAIL_FROM=TalkMate <onboarding@resend.dev>

# --- Google sign-in (OAuth "Web application" client ID) ---
GOOGLE_CLIENT_ID=

# --- stock photos (optional; emoji fallback without them) ---
PIXABAY_API_KEY=
PEXELS_API_KEY=
# Folder for downloaded/uploaded pictures. Falls back to RAILWAY_VOLUME_MOUNT_PATH, then ./media.
MEDIA_DIR=
