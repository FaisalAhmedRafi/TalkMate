generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String             @id @default(cuid())
  email        String             @unique
  name         String?
  passwordHash String
  createdAt    DateTime           @default(now())
  progress     Progress?
  entries      PracticeEntry[]
  days         PracticeDay[]
  sentences    SentenceProgress[]
  words        WordProgress[]

  referralCode     String?          @unique // the code in the user's invite link
  referredById     String?
  referredBy       User?            @relation("Referrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals        User[]           @relation("Referrals")
  referralRewarded Boolean          @default(false) // the free months for this user's referral were paid out
  personalization  Personalization?
  subscription     Subscription?
}

model Progress {
  userId         String   @id
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  xp             Int      @default(0)
  streak         Int      @default(0)
  longest        Int      @default(0)
  messages       Int      @default(0)
  lastDay        String? // UTC date, YYYY-MM-DD
  premium        Boolean  @default(false)
  giftClaimed    Boolean  @default(false)
  language       String   @default("Spanish")
  level          String   @default("Beginner")
  nativeLanguage String   @default("English") // what translations and feedback are written in
  updatedAt      DateTime @updatedAt
}

model PracticeEntry {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  day       String // UTC date, YYYY-MM-DD
  text      String
  createdAt DateTime @default(now())

  @@index([userId, day])
}

model PracticeDay {
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  day     String // the user's local date from the browser, YYYY-MM-DD
  seconds Int    @default(0)

  @@id([userId, day])
}

model SentenceProgress {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  skillId   String // matches an id in src/sentence/sentence.catalog.ts
  bestScore Float    @default(0) // best session average, 1-5
  lastScore Float    @default(0)
  attempts  Int      @default(0)
  passed    Boolean  @default(false) // a session average of 3 or more
  updatedAt DateTime @updatedAt

  @@id([userId, skillId])
}

model Personalization {
  userId    String  @id
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  reason    String?
  frequency String?
  goal      String?
  style     String?
  ageRange  String?
}

// Demo subscriptions: billing is not connected yet.
model Subscription {
  userId           String   @id
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  months           Int      @default(1) // plan length
  status           String   @default("active") // active | paused | canceled
  currentPeriodEnd DateTime // end of the period already paid for
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model WordProgress {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  wordId    String // matches an id in src/word/word.catalog.ts
  language  String // the language being learned: the same word is a separate lesson in each language
  lesson    Json? // the generated lesson (word, translation, sentences), kept so "Continue" shows the same content
  step      Int      @default(0) // 0 = word card, 1..N = the sentence being practised
  scores    Json     @default("[]") // per sentence: 1-5, or null when skipped or not reached
  finished  Boolean  @default(false) // the current run is done
  passed    Boolean  @default(false) // ever passed (an average of 3 or more)
  bestScore Float    @default(0)
  attempts  Int      @default(0)
  updatedAt DateTime @updatedAt

  @@id([userId, wordId, language])
}
