# TalkMate web app — copy to .env.local (git-ignored). NEXT_PUBLIC_* values are built into
# the browser bundle, so never put a secret here.
NEXT_PUBLIC_API_URL=http://localhost:4000
# Same value as the API's GOOGLE_CLIENT_ID; without it the login page hides the Google button.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# 1 = use public/characters/<id>.jpg portraits when present
NEXT_PUBLIC_CHARACTER_PORTRAITS=
